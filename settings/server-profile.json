{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash(*)",
      "Glob(**)",
      "Grep(**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf /var/log)",
      "Bash(dd if=/dev/zero of=/dev/sd*)",
      "Bash(dd if=/dev/zero of=/dev/nvme*)",
      "Bash(dd if=/dev/random of=/dev/sd*)",
      "Bash(dd if=/dev/random of=/dev/nvme*)",
      "Bash(dd if=/dev/urandom of=/dev/sd*)",
      "Bash(dd if=/dev/urandom of=/dev/nvme*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.ext2:*)",
      "Bash(mkfs.ext3:*)",
      "Bash(mkfs.ext4:*)",
      "Bash(mkfs.xfs:*)",
      "Bash(mkfs.btrfs:*)",
      "Bash(mkfs.fat:*)",
      "Bash(mkfs.vfat:*)",
      "Bash(shred:*)",
      "Bash(chmod 777 /)",
      "Bash(chmod 777 /etc)",
      "Bash(chmod 777 /etc/*)",
      "Bash(chmod 777 /root)",
      "Bash(chmod 000 /)",
      "Bash(chmod 000 /etc)",
      "Bash(chmod 000 /etc/shadow)",
      "Bash(chmod 000 /etc/sudoers)",
      "Bash(passwd root)",
      "Bash(userdel root)",
      "Bash(usermod -L root)",
      "Bash(useradd -o -u 0:*)",
      "Bash(iptables -F)",
      "Bash(iptables -X)",
      "Bash(ip6tables -F)",
      "Bash(ip6tables -X)",
      "Bash(ufw --force reset)",
      "Bash(systemctl disable ssh)",
      "Bash(systemctl disable sshd)",
      "Bash(systemctl stop ssh)",
      "Bash(systemctl stop sshd)",
      "Bash(systemctl mask:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt)",
      "Bash(poweroff:*)",
      "Bash(init 0)",
      "Bash(init 6)",
      "Bash(history -c)",
      "Bash(unset HISTFILE)",
      "Bash(export HISTFILE=/dev/null)",
      "Write(/etc/passwd)",
      "Write(/etc/shadow)",
      "Write(/etc/sudoers)",
      "Write(/etc/ssh/sshd_config)",
      "Write(/root/.ssh/authorized_keys)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Edit(/etc/ssh/sshd_config)",
      "Edit(/root/.ssh/authorized_keys)"
    ]
  }
}

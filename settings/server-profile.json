{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": [
    "Permission profile for an assistant living on a server it owns an account on.",
    "",
    "This is Chapter 25's own lesson written as a file. On a laptop the leash is a",
    "question: it asks, you answer. On a server at three in the morning there is",
    "nobody to answer, so a question is the same as a refusal, and the whole job",
    "dies waiting. The leash has to be the walls instead: an account that can reach",
    "almost nothing, with permission to act inside it granted in advance.",
    "",
    "So `allow` is broad and `deny` is the short list of things that are never a",
    "good idea even inside your own home directory. Adapted from the Hermes DevOps",
    "Kit's conservative profile, which is where this list was built and proven; the",
    "audit hooks belong to that product and are not here."
  ],
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash(*)",
      "Glob(**)",
      "Grep(**)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf /var/log)",
      "Bash(dd if=/dev/zero of=/dev/sd*)",
      "Bash(dd if=/dev/zero of=/dev/nvme*)",
      "Bash(dd if=/dev/random of=/dev/sd*)",
      "Bash(dd if=/dev/random of=/dev/nvme*)",
      "Bash(dd if=/dev/urandom of=/dev/sd*)",
      "Bash(dd if=/dev/urandom of=/dev/nvme*)",
      "Bash(mkfs:*)",
      "Bash(mkfs.ext2:*)",
      "Bash(mkfs.ext3:*)",
      "Bash(mkfs.ext4:*)",
      "Bash(mkfs.xfs:*)",
      "Bash(mkfs.btrfs:*)",
      "Bash(mkfs.fat:*)",
      "Bash(mkfs.vfat:*)",
      "Bash(shred:*)",
      "Bash(chmod 777 /)",
      "Bash(chmod 777 /etc)",
      "Bash(chmod 777 /etc/*)",
      "Bash(chmod 777 /root)",
      "Bash(chmod 000 /)",
      "Bash(chmod 000 /etc)",
      "Bash(chmod 000 /etc/shadow)",
      "Bash(chmod 000 /etc/sudoers)",
      "Bash(passwd root)",
      "Bash(userdel root)",
      "Bash(usermod -L root)",
      "Bash(useradd -o -u 0:*)",
      "Bash(iptables -F)",
      "Bash(iptables -X)",
      "Bash(ip6tables -F)",
      "Bash(ip6tables -X)",
      "Bash(ufw --force reset)",
      "Bash(systemctl disable ssh)",
      "Bash(systemctl disable sshd)",
      "Bash(systemctl stop ssh)",
      "Bash(systemctl stop sshd)",
      "Bash(systemctl mask:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt)",
      "Bash(poweroff:*)",
      "Bash(init 0)",
      "Bash(init 6)",
      "Bash(history -c)",
      "Bash(unset HISTFILE)",
      "Bash(export HISTFILE=/dev/null)",
      "Write(/etc/passwd)",
      "Write(/etc/shadow)",
      "Write(/etc/sudoers)",
      "Write(/etc/ssh/sshd_config)",
      "Write(/root/.ssh/authorized_keys)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Edit(/etc/ssh/sshd_config)",
      "Edit(/root/.ssh/authorized_keys)"
    ]
  }
}
